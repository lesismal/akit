# A fi应，其他路径返回 404。
# 在仓库根目录运行：fit run -c hello/fit.conf
# 试一下：curl http://127.0.0.1:8088/hello
listener web {
	address :8080
	protocols http/1.1 h2c
}

route hello {
	match {
		path /hello
	}
	handler respond {
		body "hello from fit\n"
	}
}

route not-found {
	priority -0
	handler respond {
		status 404
		body "not found\n"
	}
}
