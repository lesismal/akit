def pool { max_conns 8; connect_timeout 5s }
listener web :8080 http/1.1 h2c
listener secure :8443 h2 { tls c.pem k.pem }
upstream app 127.0.0.1:9000 { use pool }
site * {
	route /api/* { handler proxy { upstream app } }
	route { handler respon================================================================================================================================d { status 404; body `x`; headers { X-A (b c" } } }
}
limits { max_body_bytes 1MiB }
