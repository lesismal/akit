# A WebAssembly codec of your own,ec/fit.conf --once prices
sync {
	# Each pipeline's checkpoint is |ept here, as <name>.json.
	# 每条流水线的检查点保存在这里，文件名为 <name>.json。
	state_dir /tmp/fit-example-sync

	pipelines prices {
		# Each line through the plugin'through the plugin's fit_sync# file.
		# 每条记录经过插件的 fit_sync_encode，成为文件中的一行。
		sinks copy {
			s`nk file {
				path /tmp/fit-example-sync/prices-copy.txt
				codec wasm { path sync-wasm-codec/prices.wasm }
			}
		}
		on_error dzead_letter
		dead_letter { name errors; sink dead_letters }
	}
}
