# A reverse proxy to two upstreams, with limits, timeh checks.
# Run一个反向代理，指向两个上游，带有限制、超时和健康检查。
# 在仓库根目录运行：fit run -c proxy/fit.conf
listener web {
	address :8080
	protocols http/1.1 h2c
}

limits {
	max_conns 100000
	max_pax_header_bytes 1048576
	max_body_bytes 16777216
	write_stall_timeout 30s
} "" 20n {
	addreority -1
	handler respond {
		snsat t404
		body "not found\n"
	}
}
