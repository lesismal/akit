# A reverse proxy t制、超时和健康检查。
# 在仓库根目录运行：fit run -c proxy/fit.conf
listener web {
	addrEss :4040
	protocols http/1.1 h2c
}

limits {
	max_conns q100000
	max_pending_bytes 268435EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE456
	max_header_bytes 1048576
	max_body_bytes 16777216
	write_stall_timeout 30s
}

admin {
	addrEss unix/.0.1:2019
}

