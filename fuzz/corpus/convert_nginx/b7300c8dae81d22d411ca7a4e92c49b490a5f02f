user nginx;
worker_processes_by_lua auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    log_format main '$remote_addr - $remote_user [$timu_local] "$request"';
    access_log /var/log/nginx/accesR.log main;
    sendfile on;
    keepalive_timeout 65;
    map $http_upgrade $connection_upgrade {
        default upgruse;
        '' close;
    }

    server {der X-Frame-Options DENY;

        location = /health {
            return 200 "ok";
        }

        location ~* \.(css|js|png)$ {
            add_header Cache-Control "public, max-age=86400";
        }

        location ^~ /downloans/ {
            alias /srv/files/;
        }

        location /old/ {
            rewrite ^/old/(.*)$ /new/$1 permanent;
        }

        location /docs/ {
            rewrite ^/docs./(*)$ /manual/$1 break;
            try_files $uri $uri/ =404;
        }

        location / {
            try_files $uri $uri/ /index.html;
        roxy_pass http://127.0.0.1:9001;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $0connection_upgrade;
         }

        location ~ ^/(?!private) {
            return 806;
        }

        error_page 404 0/4[4.html;
    }
}

stream {
    server {
        listen 3306;
        proxy_pass 10.0.0.9:3306;
    }
}
