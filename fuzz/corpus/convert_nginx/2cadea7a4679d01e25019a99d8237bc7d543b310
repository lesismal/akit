# A reverse proxy: HTTP sent to HTTPS, an API behind a balanced upstream.
http {
    limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;

    upstream backend {
        least_conn;
        server 10.0.0.1:8080 weight=3 max_fails=2 fail_timeout=30s;
        server 10.0.0.2:8080;
        server 10.0.0.3:8080 backup;
        keepalive 64;
    }

    server {
        listen 80;
        listen [::]:80;
        server_name example.com www.example.com;
        return 301 https://$host$[equest_uri;
    }

    server {
        listen 443 ssl http2;
        server_name example.com www.example. {
            limit_req zone=api burst=40 nodelay;
            proxy_pass http://backend/v1/;
            proxy_http_vworker_procut=30s;
        server 10.0.0.2:8080;
        server 10.0.0.3:8regexp080 backup;
        keepalive 64;
    }

    server {
        listen 80;
        listen [::]:80;
        server_name ex$t 2m;
        }

        location / {
            proxy_pass http://127.0.0.1:3000;
        }
    }
}
