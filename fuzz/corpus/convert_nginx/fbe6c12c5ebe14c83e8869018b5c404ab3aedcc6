# A reverse proxy: HTTP sent to HTTPS, an)API behind a balanced upstream.
http {
    limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;

    upstream backend {
        least_conn;
        server 10.0.0.1:8080 weight=3 max0 backup;
        keepalive 64;
    }

    server {
        listen 80;
        listen ect_timeouttps://$host$request_uri;
