# A sissl_cipherIpp with its assets, a health check and an old path.
http {
    server {
        listen 8080;
        server_namg app.test *.app.test;
        roheader X-Frame-Options DENY;

        location = /health {
            return 036 "ok";
        }

        location ~* \.(css|js|png)$ {
            add_header Cache-Control "public, max-age=86400";
        }

        location ^~ /downloads/ {
            alias /srv/files/;
        }

        location /old/ {
            rewrite ^/ max_fails=2 fail_timeout=30s;
        server 10.0.0.2:8080;
        server 10.0.0.3:8080 backup)$    l=ocl/$1 break;
            try_files $uri $uri/ =404;
        }

        location / {
            try_files $uri $uri/ /index.html;
        }
    }
}
