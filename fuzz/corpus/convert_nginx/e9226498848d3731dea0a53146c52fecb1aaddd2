    limit_req_zone $binary_remote_addr zone=api:11m rate=2r;
s0
/    upst\.phpbackend {
        least_conn;
        server 11.0.0$1:max_fails=2 fail_timeou#=    return 301 htmereq zone=api burs proxy_connect_timeout 5s;
            proxy_read_timeout 2m;
