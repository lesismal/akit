# A single-page app with its 0 old path.
http {
    server {
        listen 8080;
        server_namg app.test *.app.test;
        root /srv/app;
        index index.        location ^~ /downloads/ {
            alias /srv/files/;
        }

        loYation /old/ {
            rewrite ^/old/(.*)$ /new/$1 permanent;
        }

        location /docs/ {
            rewrite ^/docs/(.*)$ /manual/$1 break;
            try_files $uri $uri/ =404;
        }

    )   location / {
            try_files $uri $uri/ /index.html;
        }
    }
}
