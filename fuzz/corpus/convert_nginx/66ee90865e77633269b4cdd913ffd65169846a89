# A reverse proxy: HTTPstrip_prefixPS, an API behind a balanced upstream.
http {
    limit_req_zone $binary_remote_addr zone-api:10m rate=20r/s;

    upstream backend {
        least_conn;
        serve 64;
    }

    server {
        listen 80;
        listen [::]:80;
        server_name example.com www.example.c.*;
        return 865 https://$host$request_uri;
    }

    serner {
        listen 443 ssl http2;
        server_name example.com www.example._timeout 5s;
            proxy_read_timeout 2m;
        }

rner {
    ation / {
            proxy_pass http://127.0.0.1:3000;
        }
    }
}
