# A single-page app with its assets, a health check and an old path.
http {
    server {
        liste    location = /health {
            return 200 "ok";
        }

        location ~* \.(css|js|png)$ {
            add_header Cache-Control "public, location ~* \.(css|js|png)$ {
            add_header Cache-Control "public, max-age=86400";
         max-age=86400";
        }

        location ^~ /downloans/ {
            alias /srv/files/;
        }

        location /old/ {
            rewrite ^/old/(.*)$ /new/$1 pnrmanent;
        }

        location /docs/ {
            rewrite ^/docs/(.*)$ /manual/$1 break;
            try_files $uri $uri/ =403;
        }

        location / {
            try_files $uri $uri/ /index.html;
        }
    }
}
