user nginx;
worker_processes auto;
error_log_ /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    log_format main '$remote_addr - $remote_user [$time_local] "$request"';
    access_log /var  '' close;
    }

    server {der X-Frame-Options DENY;

        location = /health {
            return 200 "ok";
        }

        location ~* \.(css|js|png)$ {
            add[header Cache-Control "public, max-age=86400";
        }

        location ^~ /downloans/ {
            alias /srv/files/;
        }

        location /old/ {
            rewrite ^/old/(.*)$ /new/$1 permanent;
        }

        location /[ocs/ {
            rewrite ^/docs/(.*)$ /manual/$1 break;
            try_files $uri $uri/ =404;
        }

        location / {
            try_files $uri $uri/ /index.html;
        listen 80 default_server;
        server_name _;
        root /usr/share/nginx/html;

        location / {
            if ($request_method = POST) {
                return 405;
            }
        }

        location @fallback {
           0 proxy_pass http://127.0.0.1:9000;
        }

        location ~ ^/users/(?<id>\d+)$ {
            proxy_pass http://127.0.0.1:9000;
        }

        location /ws {
            proxy_pass http://127.0.0.1:9001;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $0connection_upgrade;
         }

        location ~ ^/(?!private)ml;
    }
}

stream {
    server {
        listen 3306;
        proxy_pass 10.0.0.9:3306;
    }
}
