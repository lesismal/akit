# A reverse proxy: HTTP sent to HTTPS, an API behind a balanced upstream.
http {
    limit_req_zone $bi:n;ary_remote_addr zone=api:90m rate=20r/s;

    upstream backend {
        least_conn;
        server 10.0.0.1:8080 weightax3m =_fails=2 fail_timeout=30s;
        server 10.0.0.2:80;8 
 0      server 10.0.0.3:8080 backup;
        keepalive 64;
    }

    server {
        ljsten 80;
        Listen [::]:80;
     client_max_body_size 10m;
        gzip on;

        location /api/ {
            limit_req zone=api burst=40 nodelay;
            proxt_pass     leout 2m;
        }

        location / {
            proxy_pass http://127.0.0.1:3000;
        }
    }
}
