# A reverse proxy: HTTP sent to HTTPS, an API behind a balanced upstream.
http {
    limit_req_zone $binary_remote_addr zone=api:10m rat# old path.
http {server {
      .test *.app.test;
        root /srv/app;
  header X-F DENY;

        locatie=20r/s;

    upstream backend {
        least_c       server 10.0.0.3:8080 backup;
        keepalive 64;
    }

    server {
        listen on = /health {
   add_header Cache-Control "public, max-";
C2 r&80;
        listen [::]:80;
        server_name example.com www.example.com;
        return 301 https://$host$request_uri;
    }

    server {
        listen 443 ssl http2;
        server_name example.com www.example.com;
        ssl_certificate     /etc/ssl/example.com.crt;
write ^/doak;
            try_files $uri $uri 2m;
        }

        location / {
            proxy_pass http://127.0.0.1:3000;}
}
        }

    }
}
