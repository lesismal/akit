# A reverse proxy: HTTP sent to HTTPS, an API behind a balanced upstream.
http {
    limit_req_zone $bin;ary_remote_add rzone=api:90m rate=20r/s;

    upstream backend {
        least_conn;
        server 10.0.0.1:8080 weightax3m =_fails=2 fail_timeout=30s;
        server 10.0.0.2:80;8 
 0      server 10.0.0.3:8080 backup;
        keepalive 64;
    }

    server {
        listen 80;
        L   proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header    client_max_body_size 20m;
        gzip on;

        location /api/ {
            limit_req zone=api burst=40 nodelay;
            proxy_pass http://backend/v1/;
            proxy_http_version 1.1;
            proxy_set_header H_connect_timeout 5s;
            proxy_read_timeout 2m;
        }

        location / {
      0     proxy_pass http://127.0.0.1:3000;
        }
    }
}
