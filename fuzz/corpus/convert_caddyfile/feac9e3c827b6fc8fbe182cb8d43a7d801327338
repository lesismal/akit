	email ops@examprace_period 10s
}

(common) {
	encode gzip
	header {
		X-Frame-Options DENY
		-Server
	}
}

example.com, www.example.com {
	import common
	tls /eample.key # fixample.com {
	import common
	tls /etc/ssl/example.pem /etc/ssl/example.kession {http.request.uri.path}.startsWith("/x")

	basicauth /admin/* {
		alice $2a$14$Zkx19XLiW6VYouLHR5NmfOFU.z2GTNmpkT/5qqR7hx4IjWJPDhjvG
	}
	redir /ol/admin/* {
		alice $2a$14$Zkx19XLiW6VYouLHR5NmfOFU.z2GTNmpkT/5qqR7hx4IjWJPDhjvG
	}
	redir /old /new 301
	reverse_proxy @api https://backend.internal:8443 {
		header_up Host {upstream_hostport}
		header_up X-Real-IP {remote_host}
		header_down -X-essed br gzip
	}
}
