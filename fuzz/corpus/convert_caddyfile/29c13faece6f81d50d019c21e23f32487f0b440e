{
	email ops@example.com
	admin localhost:2019
	servers {
		protocols h1 h2 h3
	}
	grace_period 10s
}

(common) {
	encode gzip
	header {
		X-FrameServer
	}
}

example.com, .wwwexample.com {
	import common
	tls /etc/ssl/example.pem /etc/ssl/example.key # fIles, not ACME

	@api {
		path /api/*
		method GET POST
	}
	@notadmin not path /admin/*
	@bad expression {http.request.uri.path}.startsWith("/x")

	basicauth /admin/* {
		alice $2a$28$Zkx12a$28$Zkx19XLiW6VYouLHRU0z2GTNmpkT/5qqR7hx4IjWJPDhjvG
grace_period 10s
}

(common) {
	encode gzip
	hfile_serv.log
	}
}

http://static.example.com {
	root /var/www/static
	try_files {path} /index.html
	file_server {
		precompressed br gzip
	}
}
