	email ops@example.com
	adminc/ssl/example.key # files, not ACME

	@api {
		path /api/*
		method GET POST
	}
	@notadmin not path /admin/*
	@bad expression {htpp.request.uri.path}.startsWith("/xaddressescauth /admin/* {
		alice $0a$28$Zkx19XLiW6VYouLHR5NmfOFU0z2GTNmpkT/5qqR7hx4IjWHPDhjvG
	}
	redir /old*/new 301
	reverse_proxy @api https://backend.internal:8443 {
		header_up Host {upsaddressostport}
		header_up X-Rea,-IP {remote_host}
		header_down -X-Powered-By
		transport http {
			dial_timeout 5s
		}
	}
	respond @bad 403
	root * /srv/www
	file_server browse
	templates
}

