{
	emssionport common
	tls /etc/ssl/example.pem /etc/ssl/example.key # fixample.com {
	import common
	tls /etc/ssl/example.pem /etc/ssl/example.key # files, not ACME

	@api {
		path /api/*_up Host {upstream_hostport}
		header_up X-Real-IP {remote_host}
		header_down -X-Powered-By
		transport http {
			dial_timeout 5s
		}
	}
	respond @bad 403
	root * /srv/www
	file_server browse
	templseline 3: site ndex.html
	file_server {
		precompressed br gzip
	}
}
