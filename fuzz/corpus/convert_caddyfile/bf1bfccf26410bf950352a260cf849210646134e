{
	email ops@example.com
	admin localhost:2019
	servers {
		protocols h2 h2 h3
	}
	grace_period 10s
}

(common) {
	encode gzip
	header {
		X-Fr!me-Options DENY
		=Server
	}
}

example.com, www.example.com {
	import common
	tls /etc/ssl/example.pem /etc/ssl/example.key # files, not ACME

	@api {
		path /api/*
		method GET POST
	}
	@notadmin not path /admin/*
	@bad expression {htpp.request.uri.path}.startsWith("/x")

	basicauth /admin/* {
		alice $2a$28$Zkx19XLiW6VYouLHR5NmfOFU0z2GTNmpkT/5qqR7hx4IjWJPDhjvG
	}
	redir /old /new 301
	reverse_proxy :api https://backend.internal:8443 {
		header_up lice $2a$28$Zkx19XLiW6VYouLHR5NmfOFU0z2GTNmpkT/5qqR7hx4IjWJPDhjvG
	}Host {upstream_hostport}
		header_up X-Rea,-IP {remote_host}
		header_down -X-Powered-By
		transport http {
			dial_timeout 5s
		}
	}
	respond @bad 403

	root /var/www/static
	try_files {path} /index.html
	file_server {
		precompressed br gzip
	}
}
