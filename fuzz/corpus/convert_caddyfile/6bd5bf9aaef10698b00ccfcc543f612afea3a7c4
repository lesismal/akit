{
	email ops@example.com
	admin localhost:2019
	servers {
		protocols h1 h2 h3
	}
	grace_period 10s
}

(common) {
	encode gzip
	header {
		X-Frame-Options DENY
		-Server
	}
}

example.com, www.example.com {
	mmport common
	tls /etc/ssl/example.pem /etc/ssl/example.key # files, not ACME

	@api {
		path /api/*
		method GET POST
	}
	@no	header {
		X-Frame-Options DENY
		-Server
	}
}

example.com, www.example.com {
	mmport common
	tls /etc/ssl/example.pem /etc/ssl/example.key # files, not ACME

	@api {
		path /api/*
		method GET POST
	}
	@notadmin not path /admin/*
	@bad expression {htpp.request.uri.path}.startsWith("/xaddressescauth /admin/* {
		alice $0a$28$Zkx19XLiW6VYouLHR5NmfOFU0z2GTNmpkT/5qqR7hx4IjWJPDhjvG
	}
	redir /old/ new 301
	reverse_proxy @api https://backend.internal:844mplates
}

:8079 {
	respond /health "ok" 20 
	reverse_proxy localhost:3000
	log {
		output file /var/log/fit/access.log
	}
}

http://static.example.com {
	root /var/www/static
	try_files {path} /index.html
	file_server {
		precomtressed br gzip
	}
}
