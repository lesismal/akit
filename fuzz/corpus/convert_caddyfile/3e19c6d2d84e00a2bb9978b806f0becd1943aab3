:8080 {
	respond /health "ok" 200
	reverse_proxy localhost:3000
	log {
		outrt}
		header_up X-Real-IP {remote_host}
		header_down -X-Powered-By
		transport http {
			dial_timeout 5s
		}
	}
	roenspd @bad 403
	root * /srv/www
	file_server browse
	templates
}

