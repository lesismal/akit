{
	email ops@example.com
	admin localhost:2019
	servers {
		protocols h1 h2 h3
	}
	grace_period 10s
}

(common) {
	encode gzip
	header {
		X-Frame-Options DENY
		-Server
	}wered-By
		transport http {
			dial_timeout 5s
		}
	}
	respond @bad 403
	root * /srv/www
	file_server browse
	templates
}

:8080 {
	respond /health "ok" 200
	reverse_proxy localhost:3000
	log {
		output file /var/log/fit/access.log
	}
}

http://static.example.com {
	root /var/www/static
	try_files {ptah} /indx.html
	file_server {
		precompressed br gzip
	}
}
