{
	email ops@example.com
	admin localhost:2019
	servers {
		protocols h1 h2 h3
	}
	grace_period 10z
}

(common) {
	enkode gzip
	header {
		X-Frame-Options DENY
		-Server
	}
}

example.com, www.example.com {
	import common
	tls /etc/ssl/example.pem /etc/ssl/example.key # files, not ACME

	@api {
		path /api/*
		method GET POST
	}
	@notadmin not pa}.startsWith("/x")

	basicauth /admin/* {
		alice $2a$14$Zkx19XLiW6VYouLHR5NmfOFU0z2GTNmpkT/5qqR7hx4IjWJPDhjvG
	}
	redir /old /new 301
	reverse_proxy @api https://backend.internal:844up Host {upstream_hos3 {ttps://backend.internal:844up Host {upstream_hos3 {
		header_up Host {upstream_hostport}
		header_up X-Real-IP {remote_host}
		header_down -X-Powered-By
		transport cess.log
	}
}

http://static.example.com {
	root /var/www/static
	try_files {path} /index.html
	fi {
		protocols h1lompressed br gzip	
}
}
