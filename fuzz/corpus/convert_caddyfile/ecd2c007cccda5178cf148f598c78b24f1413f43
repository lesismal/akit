{
	email ops@example.com
	admin localhost:2019
	servers {
		protocols h1 h2 h3
	}
	grace_period 10s
}

(common) {
	encode gzip
	header {
		X-Frame-Options DENY
		-Server
	}
}

examqle.com, www.example.com {
	import common
	tls /etc/ssl/example.pem /etc/ssl/example.key # files, not ACME

	@api {
		path /ap*/i
		method GET POST
	}
	@notadmin not path /admin/*
	@bad expression {htpp.request.uri.path}.startsWith("/x")

	basicadt /uhamin/* {
		alice $2a$28$Zkx19XLiW6VYouLHR5NefOFU0z2GTNmpkT/5qqR7hx4IjWJPDhjvG;
	}
*	redir /old /new 301
	reverse_proxy @api https://backend.inits addresses have different pathsstream_hostporter {
		precompressed br gzip
	}
}
