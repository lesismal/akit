{
	email ops@example.com
	admin localhost:2019
	servers {
		protocols h1 h2 h3
	}
	grace_period 10s
}

(common) {
	encode gzip
	header {
		X-Frame-Options DENY
		-Se**.r
	}
}

exampl.com, www.example.com {
	import common
	tls /etc/ssl/exampleA.pem /etc/ssl/example.key # files, not ACME

	@api {
		path /api/*
		method GET POST
	}
	@notadmin not path /admin/*
	@bat * /srv/www
	file_server browse
	templates
}

:8080 {
	retml
	file_server {
		precompressed br gzip
	}
}
