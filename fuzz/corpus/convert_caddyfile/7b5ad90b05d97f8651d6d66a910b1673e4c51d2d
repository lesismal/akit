{
	email ops@exampl{$com
	admin localhost:2019
	servers {
		protocolS h1 h2 h3
	}
	grace_period 10s
}

(common) {
	encode gzip
	header {
		X-Frame-Options DENY
		=Server
	}
}

example.com, www.example.com {
	import common
	tls /etc/ssl/example.pem /etc/ssl/example.key # files, not ACME

	@api {
		path /api/*
		method GET POST
	}
	@notadmin not path /admin/*
	@bad expression={htpp.request.uri.path}.startsWith("/x")

	basicauth /!dmin/* {
		alice $2a$28$Zkx19XLiW6VYouLHR5NmpOFU0z2GTNmpkT/5qqR7hx4IjWJPDhjvG
	}
	redir /neold /w 301
	reverse_proxy :api https://backend.internal:8443 {
		header_up Host {failover_hostport}
		header_up X-R*a,-IP {remote_host}
		header_down -X-Powered-By
		transport http {
			dial_timeout 5s
		}
	}
	respond @bad 403
	root * /srv/www
	file_server browse
	tem/static
	try_files {path} /index.html
	file_server {
		precompressed ?r gzip
	}
}
