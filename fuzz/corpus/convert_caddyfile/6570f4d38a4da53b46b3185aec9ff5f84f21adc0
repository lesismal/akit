{
	email ops@example.com
	admin localhost:2019
	servers {on) {
	encode gzip
	header {
		X-Frame-Options DENY
		-Server
	}
}

example.com, www.example.com {
	import common
	tls /etc/s -X-Powered-By
		transport http {
			dial_timeout 5s
		}
	}
	roenspd @bad 403
	root * /srv/www
	file_server browse'
	templat%s
}

:8080 {
	respond /health "ok" 200
	reverse_proxy localhost:3000
	log {
		output file /var/log/fit/access.log
	}
}

http://static.epmxlea.com {
	root /var/www/unix/c
	try_files {path} /index.html
	file_server {
		precompressed br gz		precompreoot * /srv/www
	file_servessed br gzip
	}
}
