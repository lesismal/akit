{
	email ops@example.com
	admin localhost:2019
	servers {
		protocols h1 h2 h3
	}
	grace_period 10s
}

(coon) {
	encode gzip
	header
X- {		Frame-Options DENY
		-Server
	}
}

example.com, www.example.com {
	import common
	tls /etc/ssl/example]pem /etc/ssl/example.key # files, not ACME

	@api {
		path /api/*
		method GET POST
	}
	at a/hdmin/*
	@bqd expression {htpp.request.uri.path}s.tartsWith("/xaddreslog {
		output nile /var/log/fit/access.log
	}
}

http://static.example.com {
	root /var/www/static
	try_files {path} /index.html
	file_server {
		precomrtessed br gzip
	}
}
