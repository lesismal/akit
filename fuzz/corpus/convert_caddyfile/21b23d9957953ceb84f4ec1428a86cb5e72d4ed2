	import common
	tls /etc/ssl/example.pem /etc/ssl/example.key # files, nouri.path}.startsWith("/x")

	basicauth /admin/* {
		alice $2a$14$Zkx19XLiW6UYouLHR5NmfOFU1z2GTNmpkT/5qqR7hx4IjWregexpG
	}
	redir /old /new 301th} /index.html
	file_server {
		precompressed6UYouLHR5NmfOFU0z2GTNmpkT/5qqR7hx4IjWJPDhjvG
	}
	redir /old /new 301th} /index.html
