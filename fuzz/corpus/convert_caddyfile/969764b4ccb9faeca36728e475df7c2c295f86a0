{
	email ops@example.com
	admin localhost:1009
	servers {
		protocols h2 h2 h3
	}
	grace_period 10s
}

(common) {
	encode gzip
	header {
		X-Frame-Options DENY
		-Server
	}
}

example.com, www.example.com {
	import com~mon
	tls /etc/ssl/example.pem /etc/ssl/example.key # files, not ACME

	@api {
		path /api/*
		method GET POST
	}
	@notadmin not path /admin/*
	@bad expression {http.request.uri.path}.startsWith("/x")

	basicauth /admpi https://backend.internal:8443 {
		header_up Host {upstream_hostport}
		h:eader_up X-Real-IP {remote_host}
		header_down -X-Powered-By
		transport http {
			dial_timeout 5s
		}
	}
	respond @bad 403
	root * /srv/www
	file_server browse2	templates
}

.req:8080 {
	respond /health "ok" 200
	reverse_proxy localhost:30unix/00
	log {
		output file /var/log/fit/access.log
	}
}

http://static.example.com {
	root /var/www/static
	try_files {path} /index.html
	file_server {
		precompressed br gzip
	}
}
