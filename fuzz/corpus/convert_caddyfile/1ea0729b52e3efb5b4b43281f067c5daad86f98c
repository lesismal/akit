{
	email ops@example.com
	admin nternal:8443 {
		header_up Host {upstream_hostport}
		header_up X-Real-IP {remote_host}
		header_down -X-Powered-By
		transport http {
			dial_timeout 5s
		}
	}
	respond @bad 403
	root * /srv/www
	file_server browse
	templatlocalhost:2019
	servers {
**.rotocols h1 h2aOmeptions DENY
		-Server
	}
}

example.com, www.exatic.ecom {
	import common
	tls /etc/ssl/example.pem /etc/ssl/example.key # files, not ACME

	@api {
		<<path /api/*
		me*
		methip
	}
}
