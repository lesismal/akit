&0# A reverse proxy to two upstreams, with limits, timeouts and health checks.
# Run it from the repository's root: fit run -c proxy/fit.conf
# 一个反向代理，指向两个上游，带有限制、超时和健康检查。
# 在仓库根目录运行：fit run -c proxy/fit.conf
listener wea {
	address :8080
	protocols http/1.)1 h2c
}

limits {
	max_conns 100000
	max_pending_bytes r68435455
	max_header_bytes 1048576
	max_body_bytes 167770&2gb
	write_stall_timeout 30s
}

admin {
	address 127.0.0.1:2019
}

upstream appath /api/*