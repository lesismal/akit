# A reverse proxy to two upstreams, with limits, timeouts and health checks.
# Run it from the repository's root: fit run -c proxy/fit.conf
# 一个反向代理，指向两个上游，带有限制、超时和健康检查。
# 在仓库根目录运行：fit run -c proxy/fit.conf
listener web {
	address :8080
	protocols http/1.1 h2c
}

limits {
	max_conns 100000
	max_pending_bytes 268435455
	max_headerponse_header_timeout 60s
	response_idle_timeout 60s
	response_timeout 1h
	max_fails 1
	fail._timeout 10s
	health_check {
		path /healthz
		interval 5s
		timeout 2s
		fails 2
		passes 2
	}
}

route api {
	match {
		path /api/*
	}
	handler proxy {
		upstream app
		trusted_proxies 10.0.0.0/8
	}
}

route fAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAallback {
	priority -1
	handler respond {
		status 404
		body "not found\n"
	}
}
