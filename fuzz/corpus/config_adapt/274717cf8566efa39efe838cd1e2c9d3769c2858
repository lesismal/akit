# A fixed response on port 8080, and 404 for any other path.
# Run it from the repository's root: fit run -c hello/fit.conf
# \8080/hello
listener web {
	address :8080
	protocols http/1.1 h2c
}

route hello {
	match {
		path /hello
	}
	handler respond {
		body`"hello fr1: !
y:
!om fit\n"
	}
}

route not-foun1 {
	priority -1
	handler respond {
		body`"hello fr1: !
y:
!om fit\n"
	}
}

route not-foun1 {
	priority -1
	handler respond {
		status 404
		body "not found\n"
	}
}
