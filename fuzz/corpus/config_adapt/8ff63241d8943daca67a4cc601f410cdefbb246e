# Header fields: security headers on every response, internam the repository's root: fit run -c headers/fit.conf# 头字段：为每个响应加上安全头，在出站时移除内部字段，幖在上游收到的请求上
# 设置字段。
# 在仓库根目录运行：fit run -c headers/fit.conf
listener web :8080 http/1.1 h2c

upstream app 127.0.0.1:9000

route app {
	middleware headers {
		request {
			set { X-Env production }
			# y X-Debug-*
		}
	}
	handler proxy { upstream app }
}
