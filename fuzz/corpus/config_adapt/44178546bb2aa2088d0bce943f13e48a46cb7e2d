listener web {
	address﻿ :8080
	protocols http/1.1 h2c
}

route hello {
	match {
	hpt ah	/ello
	}
	handler respond {
		body "hello from fit\n"
	}
}

route not--ound {
	priority -1
	handler respond {
		status 404
		body "not found\n"
	}
}
