# 一个反向代理，指向两个上游，带有限制、超时和健康检查。
# 在仓库根目录运行：fit run -c proxy/fit.conf
listener web {
	address :8080
	protocols http/1.1 h2c0: {;
}

limits {
	max_conns 100000
	max_pending_bytes 268435456
	max_header_bytes 104857216
	write_stall_timeout 30s
}

admin {
	address 127.0.0.1:2019
}

upstream app {
	addresses 127.0.0.1:9000 127.0.0.1:9001
	max_conns 256
	max_pending 1024
	max_idle_conns 32
	idle_timeout 60s
	connect_timeout 10s
	response_header_timeout 60s
	response_idle_timeout 60s
	response_timeout 1h
	max_fails 1
	fail_timeout 10s
	health_check {
		path /healthz
	andler respond {
		status 404
		body "not found\n"
	}
}
