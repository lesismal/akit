// akit for fit's benchmark harness (bench/README.md), as fit's bench/configs/fit/fit.conf is for
// fit, with what akit serves so far: the fixed and static scenarios.
//
// Port 8080 serves HTTP/1.1 and port 8081 h2c (HTTP/2 with prior knowledge). fit's 8081 serves
// h2c alone; akit's takes HTTP/1.1 too, since akio's server always does, which no run on 8081
// uses. Port 8443 serves HTTP/1.1 over TLS and 8445 h2 over TLS, as fit's, with fitbench's
// certificate mounted at /certs (I09). The static and site routes serve fitbench's files, mounted
// at /srv/www as for fit (I12). The proxy (I15) serves /proxy, /proxy/* and /api/* from
// fitbench's backend, as fit's does. HTTP/3 (8444) and the cache are not in the harness's runs
// of akit yet.
//
// The backend's pool is fit's ("def pool" in fit.conf): {{BACKEND_CONNS}} connections at most, as
// many requests waiting and as many idle, an idle one closed after 60s, a 5s connect timeout, and
// a failure never takes the only backend out of rotation (max_fails 0); the proxy route waits 60s
// for it, as fit's (I25; I20 and I17 built the settings). /ws proxies WebSockets to fitbench's
// WebSocket backend (I49), for the harness's idle WebSocket connections, as fit's route ws.
//
// fit's other aligned settings (engine.backlog, limits.max_conns) are not settings akit has yet:
// akio's defaults apply (bench/README.md says which).
{
  "listeners": [
    {"name": "h1", "address": ":8080", "protocols": ["http/1.1"]},
    {"name": "h2c", "address": ":8081", "protocols": ["http/1.1", "h2c"]},
    {"name": "tls", "address": ":8443", "protocols": ["http/1.1"],
     "tls": {"certificates": [{"cert_file": "/certs/cert.pem", "key_file": "/certs/key.pem"}]}},
    {"name": "h2", "address": ":8445", "protocols": ["h2"],
     "tls": {"certificates": [{"cert_file": "/certs/cert.pem", "key_file": "/certs/key.pem"}]}}
  ],
  "upstreams": [
    {"name": "backend", "addresses": ["{{BACKEND}}"],
     "max_conns": {{BACKEND_CONNS}}, "max_pending": {{BACKEND_CONNS}}, "max_idle_conns": {{BACKEND_CONNS}},
     "idle_timeout": "60s", "connect_timeout": "5s", "max_fails": 0},
    {"name": "wsbackend", "addresses": ["{{WSBACKEND}}"]}
  ],
  "routes": [
    {
      "name": "proxy",
      "match": {"path": ["/proxy", "/proxy/*", "/api/*"]},
      "handler": {"module": "proxy", "params": {"upstream": "backend", "timeout": "60s"}}
    },
    {"name": "ws", "match": {"path": ["/ws"]}, "handler": {"module": "proxy", "params": {"upstream": "wsbackend"}}},
    {
      "name": "fixed",
      "match": {"path": ["/fixed"]},
      "handler": {
        "module": "respond",
        "params": {"headers": {"Content-Type": "text/plain"}, "body": "hello, world"}
      }
    },
    {"name": "static", "match": {"path": ["/static/*"]}, "handler": {"module": "static", "params": {"root": "/srv/www"}}},
    {"name": "site", "match": {"path": ["/site/*"]}, "handler": {"module": "static", "params": {"root": "/srv/www"}}}
  ]
}
