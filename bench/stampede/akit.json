// akit for the stampede check (bench/stampede.sh): its cache, with its lock (on by default), in
// front of the slow origin. HTTP/1.1 on 19180, h2c on 19181. akit-nolock.json is the same with
// disable_lock, the control: every client's miss reaches the origin.
{
  "listeners": [
    {"name": "h1", "address": ":19180", "protocols": ["http/1.1"]},
    {"name": "h2c", "address": ":19181", "protocols": ["http/1.1", "h2c"]}
  ],
  "upstreams": [{"name": "origin", "addresses": ["127.0.0.1:19103"]}],
  "routes": [
    {"name": "ready", "match": {"path": ["/ready"]}, "handler": {"module": "respond", "params": {"body": "ok"}}},
    {
      "name": "stampede",
      "match": {"path": ["/stampede/*"]},
      "middleware": [{"module": "cache", "params": {"zone": "stampede"}}],
      "handler": {"module": "proxy", "params": {"upstream": "origin"}}
    }
  ]
}
