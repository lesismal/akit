# akit as a systemd service, with its config at /etc/akit/akit.json. See
# deploy/README.md: it runs as the user akit (akit.sysusers), may bind ports
# below 1024, keeps state such as ACME's certificates in /var/lib/akit, and
# reloads its config on `systemctl reload akit`.
[Unit]
Description=akit, a reverse proxy and API gateway on akio
Documentation=https://github.com/lesismal/akit/blob/main/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=akit
Group=akit
ExecStartPre=/usr/local/bin/akit validate -c /etc/akit/akit.json
ExecStart=/usr/local/bin/akit run -c /etc/akit/akit.json
# A config that does not validate fails the reload, and akit keeps the one it runs.
ExecReload=/usr/local/bin/akit validate -c /etc/akit/akit.json
ExecReload=/bin/kill -HUP $MAINPID
# akit waits up to its -shutdown-timeout, 30s, for requests in flight.
TimeoutStopSec=40
Restart=on-failure
RestartSec=2s
LimitNOFILE=1048576
UMask=0077

StateDirectory=akit
RuntimeDirectory=akit
ConfigurationDirectory=akit
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
