{
  "listeners": [
    {
      "name": "http_80",
      "address": ":80",
      "protocols": [
        "http/1.1"
      ]
    },
    {
      "name": "https_443",
      "address": ":443",
      "protocols": [
        "http/1.1"
      ],
      "tls": {
        "certificates": [
          {
            "cert_file": "/etc/nginx/tls/shop.crt",
            "key_file": "/etc/nginx/tls/shop.key"
          }
        ]
      }
    }
  ],
  "upstreams": [
    {
      "name": "shop_api",
      "addresses": [
        "10.0.1.10:8080",
        "10.0.1.11:8080"
      ],
      "load_balancing": "least_conn",
      "connect_timeout": "3s"
    },
    {
      "name": "proxy_10_0_1_20_9000",
      "addresses": [
        "10.0.1.20:9000"
      ]
    },
    {
      "name": "proxy_10_0_1_30_3000",
      "addresses": [
        "10.0.1.30:3000"
      ]
    }
  ],
  "routes": [
    {
      "name": "shop.example.com",
      "listeners": [
        "http_80"
      ],
      "match": {
        "host": [
          "shop.example.com"
        ]
      },
      "middleware": [
        {
          "module": "redirect",
          "params": {
            "status": 301,
            "to": "https://{host}{uri}"
          }
        }
      ],
      "handler": {
        "module": "respond",
        "params": {
          "status": 404
        }
      }
    },
    {
      "name": "shop.example.com-api",
      "listeners": [
        "https_443"
      ],
      "match": {
        "host": [
          "shop.example.com"
        ],
        "path": [
          "/api/*"
        ]
      },
      "middleware": [
        {
          "module": "rate_limit",
          "params": {
            "burst": 20,
            "key": "ip",
            "rate": 10
          }
        },
        {
          "module": "body_limit",
          "params": {
            "max_bytes": 20971520
          }
        }
      ],
      "handler": {
        "module": "proxy",
        "params": {
          "upstream": "shop_api"
        }
      }
    },
    {
      "name": "shop.example.com-admin",
      "listeners": [
        "https_443"
      ],
      "match": {
        "host": [
          "shop.example.com"
        ],
        "path": [
          "/admin/*"
        ]
      },
      "middleware": [
        {
          "module": "body_limit",
          "params": {
            "max_bytes": 20971520
          }
        }
      ],
      "handler": {
        "module": "proxy",
        "params": {
          "upstream": "proxy_10_0_1_20_9000"
        }
      }
    },
    {
      "name": "shop.example.com-2",
      "listeners": [
        "https_443"
      ],
      "match": {
        "host": [
          "shop.example.com"
        ],
        "path": [
          "/*"
        ]
      },
      "middleware": [
        {
          "module": "body_limit",
          "params": {
            "max_bytes": 20971520
          }
        }
      ],
      "handler": {
        "module": "proxy",
        "params": {
          "upstream": "proxy_10_0_1_30_3000"
        }
      }
    }
  ]
}
