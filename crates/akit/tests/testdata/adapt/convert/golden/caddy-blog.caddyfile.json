{
  "routes": [
    {
      "name": "blog.example.net-feed.xml",
      "match": {
        "host": [
          "blog.example.net"
        ],
        "path": [
          "/feed.xml"
        ]
      },
      "middleware": [
        {
          "module": "compress",
          "params": {
            "encodings": [
              "zstd",
              "gzip"
            ]
          }
        }
      ],
      "handler": {
        "module": "static",
        "params": {
          "root": "/var/www/blog"
        }
      }
    },
    {
      "name": "blog.example.net-api",
      "match": {
        "host": [
          "blog.example.net"
        ],
        "path": [
          "/api/*"
        ]
      },
      "middleware": [
        {
          "module": "compress",
          "params": {
            "encodings": [
              "zstd",
              "gzip"
            ]
          }
        },
        {
          "module": "rewrite",
          "params": {
            "strip_prefix": [
              "/api"
            ]
          }
        }
      ],
      "handler": {
        "module": "proxy",
        "params": {
          "upstream": "proxy_10_0_2_5_4000"
        }
      }
    },
    {
      "name": "blog.example.net",
      "match": {
        "host": [
          "blog.example.net"
        ]
      },
      "middleware": [
        {
          "module": "compress",
          "params": {
            "encodings": [
              "zstd",
              "gzip"
            ]
          }
        }
      ],
      "handler": {
        "module": "static",
        "params": {
          "root": "/var/www/blog"
        }
      }
    },
    {
      "name": "www.blog.example.net-default",
      "match": {
        "host": [
          "www.blog.example.net"
        ]
      },
      "middleware": [
        {
          "module": "redirect",
          "params": {
            "status": 301,
            "to": "https://blog.example.net{uri}"
          }
        }
      ],
      "handler": {
        "module": "respond"
      }
    }
  ],
  "upstreams": [
    {
      "name": "proxy_10_0_2_5_4000",
      "addresses": [
        "10.0.2.5:4000",
        "10.0.2.6:4000"
      ],
      "load_balancing": "least_conn",
      "health_check": {
        "path": "/healthz",
        "interval": "10s"
      }
    }
  ],
  "admin": {},
  "acme": {
    "email": "ops@example.net"
  }
}
