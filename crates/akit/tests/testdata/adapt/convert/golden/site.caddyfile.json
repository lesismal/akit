{
  "routes": [
    {
      "name": "example.com-api",
      "match": {
        "host": [
          "example.com"
        ],
        "path": [
          "/api/*"
        ]
      },
      "middleware": [
        {
          "module": "compress",
          "params": {
            "encodings": [
              "zstd",
              "gzip"
            ]
          }
        },
        {
          "module": "rewrite",
          "params": {
            "strip_prefix": [
              "/api"
            ]
          }
        }
      ],
      "handler": {
        "module": "proxy",
        "params": {
          "upstream": "proxy_127_0_0_1_9000"
        }
      }
    },
    {
      "name": "example.com",
      "match": {
        "host": [
          "example.com"
        ]
      },
      "middleware": [
        {
          "module": "compress",
          "params": {
            "encodings": [
              "zstd",
              "gzip"
            ]
          }
        }
      ],
      "handler": {
        "module": "static",
        "params": {
          "root": "/srv/www"
        }
      }
    }
  ],
  "upstreams": [
    {
      "name": "proxy_127_0_0_1_9000",
      "addresses": [
        "127.0.0.1:9000",
        "127.0.0.1:9001"
      ],
      "load_balancing": "least_conn",
      "health_check": {
        "path": "/healthz"
      }
    }
  ],
  "admin": {}
}
