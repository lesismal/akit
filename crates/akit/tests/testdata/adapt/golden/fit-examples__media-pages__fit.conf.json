{
  "listeners": [
    {
      "name": "web",
      "address": ":8080",
      "protocols": [
        "http/1.1",
        "h2c"
      ]
    }
  ],
  "media_auth": [
    {
      "name": "media",
      "secret": "replace-me-with-a-long-random-secret",
      "public": [
        "play"
      ],
      "users": [
        {
          "name": "alice",
          "password_hash": "$2a$10$Fq1ONPcWafh7L8Rqw/wBlOX87AVAV7hZrin/rWwd7vUZv6MlW.v.G",
          "publish": [
            "*"
          ],
          "play": [
            "*"
          ]
        },
        {
          "name": "guest",
          "password": "guest-password",
          "publish": [
            "lobby-*"
          ],
          "play": [
            "lobby-*"
          ]
        }
      ]
    }
  ],
  "routes": [
    {
      "name": "pages",
      "match": {
        "path": [
          "/media",
          "/media/*"
        ]
      },
      "handler": {
        "module": "media_pages",
        "params": {
          "auth": "media",
          "login": true,
          "title": "fit media"
        }
      }
    },
    {
      "name": "publish",
      "match": {
        "path": [
          "/whip/*"
        ]
      },
      "handler": {
        "module": "whip",
        "params": {
          "auth": "media"
        }
      }
    },
    {
      "name": "play",
      "match": {
        "path": [
          "/whep/*"
        ]
      },
      "handler": {
        "module": "whep",
        "params": {
          "auth": "media"
        }
      }
    }
  ],
  "webrtc": {
    "media": {
      "listen": ":8189",
      "max_streams": 64,
      "max_viewers": 64
    }
  }
}
