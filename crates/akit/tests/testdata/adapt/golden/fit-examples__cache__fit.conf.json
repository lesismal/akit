{
  "listeners": [
    {
      "name": "web",
      "address": ":8080",
      "protocols": [
        "http/1.1",
        "h2c"
      ]
    }
  ],
  "upstreams": [
    {
      "name": "origin",
      "addresses": [
        "127.0.0.1:9000"
      ]
    }
  ],
  "routes": [
    {
      "name": "cached",
      "match": {
        "method": [
          "GET",
          "HEAD"
        ]
      },
      "middleware": [
        {
          "module": "cache",
          "params": {
            "zone": "origin",
            "max_bytes": 268435456,
            "max_entry_bytes": 8388608,
            "default_ttl": "5m",
            "lock_timeout": "5s",
            "stale_while_revalidate": "1m",
            "stale_if_error": "1h"
          }
        }
      ],
      "handler": {
        "module": "proxy",
        "params": {
          "upstream": "origin"
        }
      }
    },
    {
      "name": "uncached",
      "priority": -1,
      "handler": {
        "module": "proxy",
        "params": {
          "upstream": "origin"
        }
      }
    }
  ]
}
