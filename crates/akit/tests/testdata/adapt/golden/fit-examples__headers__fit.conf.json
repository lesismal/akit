{
  "listeners": [
    {
      "name": "web",
      "address": ":8080",
      "protocols": [
        "http/1.1",
        "h2c"
      ]
    }
  ],
  "upstreams": [
    {
      "name": "app",
      "addresses": [
        "127.0.0.1:9000"
      ]
    }
  ],
  "routes": [
    {
      "name": "app",
      "middleware": [
        {
          "module": "headers",
          "params": {
            "request": {
              "set": {
                "X-Env": "production"
              },
              "delete": [
                "X-Internal-*"
              ]
            },
            "response": {
              "set": {
                "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
                "X-Content-Type-Options": "nosniff",
                "Referrer-Policy": "strict-origin-when-cross-origin"
              },
              "add": {
                "Vary": [
                  "Accept-Encoding"
                ]
              },
              "delete": [
                "Server",
                "X-Powered-By",
                "X-Debug-*"
              ]
            }
          }
        }
      ],
      "handler": {
        "module": "proxy",
        "params": {
          "upstream": "app"
        }
      }
    }
  ]
}
