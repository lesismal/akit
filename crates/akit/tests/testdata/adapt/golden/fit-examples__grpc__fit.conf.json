{
  "listeners": [
    {
      "name": "grpc",
      "address": ":8080",
      "protocols": [
        "h2c"
      ]
    }
  ],
  "upstreams": [
    {
      "name": "greeter",
      "addresses": [
        "127.0.0.1:50051"
      ],
      "protocol": "h2c",
      "response_idle_timeout": "10m",
      "response_timeout": "1h",
      "health_check": {
        "type": "tcp",
        "interval": "5s"
      }
    }
  ],
  "routes": [
    {
      "name": "greeter",
      "match": {
        "path": [
          "/helloworld.Greeter/*"
        ]
      },
      "handler": {
        "module": "proxy",
        "params": {
          "upstream": "greeter"
        }
      }
    }
  ]
}
