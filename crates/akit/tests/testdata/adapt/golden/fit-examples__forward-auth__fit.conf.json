{
  "listeners": [
    {
      "name": "web",
      "address": ":8080",
      "protocols": [
        "http/1.1",
        "h2c"
      ]
    }
  ],
  "upstreams": [
    {
      "name": "auth",
      "addresses": [
        "127.0.0.1:9091"
      ]
    },
    {
      "name": "app",
      "addresses": [
        "127.0.0.1:9000"
      ]
    }
  ],
  "routes": [
    {
      "name": "app",
      "middleware": [
        {
          "module": "forward_auth",
          "params": {
            "upstream": "auth",
            "uri": "/api/verify",
            "request_headers": [
              "Cookie",
              "Authorization"
            ],
            "copy_headers": [
              "Remote-User",
              "Remote-Groups",
              "Remote-Email"
            ],
            "timeout": "5s"
          }
        }
      ],
      "handler": {
        "module": "proxy",
        "params": {
          "upstream": "app"
        }
      }
    }
  ]
}
