{
  "listeners": [
    {
      "name": "socks",
      "address": ":1080",
      "protocols": [
        "socks"
      ],
      "socks": {
        "clients": [
          "127.0.0.1/32",
          "10.0.0.0/8"
        ],
        "allow": [
          "*.example.com",
          "example.com",
          "10.1.0.0/16"
        ],
        "deny": [
          "169.254.169.254"
        ],
        "ports": [
          80,
          443
        ],
        "connect_timeout": "10s",
        "idle_timeout": "5m"
      }
    }
  ]
}
