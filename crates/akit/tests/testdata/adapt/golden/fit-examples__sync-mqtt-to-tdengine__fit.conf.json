{
  "sync": {
    "state_dir": "/tmp/fit-example-sync",
    "pipelines": [
      {
        "name": "meters",
        "source": {
          "module": "mqtt",
          "params": {
            "servers": [
              "mqtt.internal:8883"
            ],
            "tls": true,
            "client_id": "fit-meters",
            "username": "fit",
            "password_env": "MQTT_PASSWORD",
            "topics": [
              "meters/#"
            ],
            "codec": {
              "module": "json"
            }
          }
        },
        "sinks": [
          {
            "name": "tdengine",
            "sink": {
              "module": "tdengine",
              "params": {
                "url": "http://tdengine.internal:6041",
                "username": "root",
                "password_env": "TD_PASSWORD",
                "database": "power",
                "mode": "sql",
                "measurement": "meters",
                "subtable": "d_{meter}",
                "tags": [
                  "location",
                  "group_id"
                ],
                "fields": [
                  "current",
                  "voltage",
                  "phase"
                ],
                "time_field": "at",
                "precision": "ms"
              }
            },
            "batch": {
              "max_records": 2000,
              "max_wait": "1s"
            }
          }
        ]
      }
    ]
  },
  "admin": {
    "address": "127.0.0.1:2019"
  }
}
